{
  "schema_version": 1,
  "initialized": true,
  "name": "Shikujin",
  "site_dir": "dist",
  "install": [],
  "start": [
    [
      "python3",
      "-m",
      "http.server",
      "4173",
      "--bind",
      "0.0.0.0"
    ]
  ],
  "ready_url": "http://127.0.0.1:4173",
  "checks": {
    "daily": [
      [
        "node",
        "tests/game/simulation.test.mjs"
      ],
      [
        "node",
        "--test",
        "tests/game/feedback.test.mjs"
      ],
      [
        "node",
        "--test",
        "tests/game/arsenal.test.mjs"
      ],
      [
        "node",
        "--test",
        "tests/game/mobile-impact.test.mjs"
      ]
    ],
    "release": [
      [
        "node",
        "tests/game/browser.mjs"
      ],
      [
        "node",
        "tests/game/polish-browser.mjs"
      ],
      [
        "node",
        "tests/game/performance.mjs"
      ],
      [
        "node",
        "tests/game/feedback-browser.mjs"
      ],
      [
        "node",
        "tests/game/arsenal-browser.mjs"
      ],
      [
        "node",
        "tests/game/mobile-impact-browser.mjs"
      ],
      [
        "node",
        "tests/game/performance.mjs",
        "--builds"
      ]
    ]
  },
  "build": [
    [
      "node",
      "scripts/build.mjs"
    ]
  ]
}
